# Copy to `mobile/.env` and fill in. Restart with `npx expo start -c` after
# changing these — Expo inlines EXPO_PUBLIC_* values at bundle time.
#
# Same project as the web app. Only the PUBLIC anon key belongs here: Row Level
# Security is what protects the data. Secret keys (service role, Stripe secret,
# Google client secret) live only in Supabase Edge Function secrets.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
