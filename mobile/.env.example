# Copy to `mobile/.env` and fill in. Restart with `npx expo start -c` after
# changing these — Expo inlines EXPO_PUBLIC_* values at bundle time.
#
# Only the PUBLIC anon key belongs here: Row Level Security is what protects the
# data. Secret keys (the service role key, RevenueCat's webhook secret) live only
# in Supabase Edge Function secrets.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# RevenueCat's PUBLIC iOS SDK key (starts with "appl_"): RevenueCat → Project
# settings → API keys. Only read by builds from EAS; Expo Go ignores it and
# shows the paywall without prices, with the development-only way past it.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
