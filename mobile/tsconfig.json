{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Resolve "./client" to "client.native.ts" the way Metro does, so TypeScript
    // checks the same file the bundler will actually use.
    "moduleSuffixes": [".native", ""],
    "paths": {
      "@/*": ["../src/*"],
      "~/*": ["./src/*"],
      // client.native.ts has to sit next to the shared data.ts it serves (that's
      // how Metro's platform resolution finds it), which puts it outside this
      // project — so TypeScript would look for its React Native imports in the
      // web app's node_modules. Point them back here.
      "@react-native-async-storage/async-storage": ["./node_modules/@react-native-async-storage/async-storage"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
