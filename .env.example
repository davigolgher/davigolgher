# The web build here is only the public legal & support pages, and needs no
# configuration to run. Flow itself is the native app — see mobile/.env.example.
#
# These two are read by src/lib/backend/client.ts, which exists so the shared
# modules typecheck from this project. Leave them empty unless you're running
# something here that talks to Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS are NOT frontend env vars. Set them as Supabase Edge Function secrets
# (`supabase secrets set NAME=value`), never in this file or the repo:
#
#   SUPABASE_SERVICE_ROLE_KEY   (Project Settings → API)
#   REVENUECAT_WEBHOOK_SECRET   (must match the Authorization value in RevenueCat)
#   APP_URL                     (e.g. https://davigolgher-lmhg.vercel.app)
#
# Only the anon/publishable keys above are safe in a client. Row Level Security
# is what protects the data.
# ─────────────────────────────────────────────────────────────────────────────
