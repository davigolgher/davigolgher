# Flow — frontend environment (Vite). Copy to `.env.local` and fill in.
# ONLY public values belong here. Leave blank to run the local demo (no backend).

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe publishable key (Developers → API keys) — safe to expose.
VITE_STRIPE_PUBLISHABLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS below are NOT frontend env vars. Set them as Supabase Edge Function
# secrets (`supabase secrets set NAME=value`), never in this file or the repo:
#
#   SUPABASE_SERVICE_ROLE_KEY   (Project Settings → API)
#   STRIPE_SECRET_KEY           (sk_live_… / sk_test_…)
#   STRIPE_WEBHOOK_SECRET       (whsec_… from the webhook endpoint)
#   STRIPE_PRICE_MONTHLY        (price_… id)
#   STRIPE_PRICE_YEARLY         (price_… id)
#   GOOGLE_CLIENT_ID            (OAuth 2.0 client)
#   GOOGLE_CLIENT_SECRET        (OAuth 2.0 client secret)
#   GMAIL_STATE_SECRET          (signs the Gmail OAuth `state`; openssl rand -base64 32)
#   APP_URL                     (e.g. https://your-app.com — checkout/OAuth return)
# ─────────────────────────────────────────────────────────────────────────────
