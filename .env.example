# The web build here is only the public legal & support pages, and needs no
# configuration to run. Flow itself is the native app — see mobile/.env.example.
#
# These two are read by src/lib/backend/client.ts, which exists so the shared
# modules typecheck from this project. Leave them empty unless you're running
# something here that talks to Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS are NOT frontend env vars. Set them as Supabase Edge Function secrets
# (`supabase secrets set NAME=value`), never in this file or the repo:
#
#   SUPABASE_SERVICE_ROLE_KEY   (Project Settings → API)
#   REVENUECAT_WEBHOOK_SECRET   (must match the Authorization value in RevenueCat)
#   APP_URL                     (e.g. https://davigolgher-lmhg.vercel.app)
#
# Flow Family (only when the feature is deployed; see docs/flow-familia):
#   PLUGGY_CLIENT_ID            (Pluggy dashboard → API credentials; use the
#   PLUGGY_CLIENT_SECRET         sandbox application until going live)
#   PLUGGY_WEBHOOK_SECRET       (a long random string; the same value goes in the
#                                webhook's "x-flow-webhook-secret" header at Pluggy)
#   PLUGGY_API_URL              (optional; default https://api.pluggy.ai)
#   PLUGGY_INCLUDE_SANDBOX      (optional; "1" lists Pluggy's test banks to
#                                everyone — development projects only)
#   PLUGGY_OAUTH_REDIRECT_URI   (optional; where a bank's consent page returns)
#   EXPO_ACCESS_TOKEN           (optional; only if Expo push "enhanced security" is on)
#
# Banks outside Brazil (docs/flow-familia/bancos-mundo.md); any subset works:
#   PLAID_CLIENT_ID, PLAID_SECRET   (Plaid: US, CA, UK, EU/EEA)
#   PLAID_ENV                   ("sandbox" or "production")
#   PLAID_SANDBOX_SECRET        (optional; lets the review accounts use Plaid's sandbox in production)
#   BANK_TOKEN_KEY              (required with Plaid: 32 random bytes, base64 — `openssl rand -base64 32`;
#                                encrypts Plaid's access tokens; keep it, or stored tokens can't be read)
#   SALTEDGE_APP_ID, SALTEDGE_SECRET   (Salt Edge: other countries)
#   SALTEDGE_PRIVATE_KEY        (Salt Edge live mode: the app's RSA key, PKCS#8 PEM)
#   SALTEDGE_CALLBACK_PUBLIC_KEY (Salt Edge's public key, PEM — callbacks are refused without it)
#   SALTEDGE_CALLBACK_URL       (the exact callback URL set at Salt Edge)
#   SALTEDGE_API_URL            (optional; default https://www.saltedge.com/api/v5)
#   BANK_SANDBOX_USER_IDS       (optional; comma-separated user ids that see the
#                                providers' test banks in production — the review accounts;
#                                PLUGGY_SANDBOX_USER_IDS is still read)
#   BANK_RETURN_URL             (optional; default flow://family/bank-return)
#
# Only the anon/publishable keys above are safe in a client. Row Level Security
# is what protects the data.
# ─────────────────────────────────────────────────────────────────────────────
